menu "Lab06_BSP_NetWork"

    config WIFI_SSID
        string "WiFi SSID"
        default "chineseljh"
        help
            The SSID of the WiFi AP to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "12345678"
        help
            The password of the WiFi AP.

    config MAXIMUM_RETRY
        int "MaxNum Retry"
        default 5
        range 1 10
        help
            Maximum number of retries before giving up the connection.

endmenu